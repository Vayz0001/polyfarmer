# ── polyfarmer configuration ──────────────────────────────────────────────────
# Optional: copy to `.env`. Everything has a default, so the bot runs with no .env.
#
# Your wallet private key is NOT configured here. Enter it in the dashboard
# (Settings → Wallet); it is stored encrypted under DATA_DIR. Never put a
# private key in this file.

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Address the dashboard listens on. Keep it on loopback and reach it remotely via
# Tailscale / an SSH tunnel / an HTTPS reverse proxy (see README). Only change
# this if you know what is in front of it - never expose it to the public internet.
# DASHBOARD_BIND=127.0.0.1:8080

# Mark the session cookie HTTPS-only. Set to true when the dashboard is served over
# HTTPS (e.g. `tailscale serve`); leave unset for plain http://localhost, where a
# Secure cookie would make login fail.
# DASHBOARD_SECURE_COOKIES=true

# ── State files (defaults shown) ──────────────────────────────────────────────
# DATA_DIR=data                                  # encrypted wallet, admin hash, setup code
# MARKETS_FILE=data/markets.json
# ALERTS_FILE=data/alerts.json
# REWARD_HISTORY_FILE=data/reward_history.json

# ── Polygon RPC (optional) ────────────────────────────────────────────────────
# Used for wallet detection and the pUSD balance. Public endpoints are tried if unset.
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=polyfarmer=info
