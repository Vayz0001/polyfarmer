# ── polyfarmer configuration ──────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit your real .env.
#
# Use a DEDICATED wallet you're comfortable running a bot with.
# Post-V2, the wallet must hold pUSD (not USDC.e) as collateral.

# EOA private key that signs orders (0x-prefixed hex)
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here

# Your Polymarket wallet address (the Gnosis Safe shown on polymarket.com/settings)
POLYMARKET_PROXY_WALLET=0xyour_polymarket_wallet_address

# ── Optional: state file paths (defaults shown) ───────────────────────────────
# MARKETS_FILE=markets.json
# ALERTS_FILE=alerts.json

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=polyfarmer=info
